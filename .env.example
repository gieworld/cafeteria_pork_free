# Kumoh Pork-Free Configuration
# Copy this file to .env and fill in your values

# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback provider (different company, so it survives Gemini's 503 spikes).
# Get from: https://openrouter.ai/keys
# Free ":free" models ALSO need https://openrouter.ai/settings/privacy to allow
# free-model providers, or every call fails with
# "No endpoints found matching your data policy".
OPENROUTER_API_KEY=your_openrouter_api_key_here
